@startuml printscript-modulos
title PrintScript — Dependencias directas declaradas en Gradle
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

component "cli\nClikt, PrintScriptCommandFactory\nPrintScriptToolchainFactory" as cli
component "common\nSourcePosition, SourceSpan" as common
component "formatter\nFormatter, TokenGapFormattingRule\nWhitespaceFormattingResult" as formatter
component "integration-tests\nPipeline, fronteras I/O\nCompatibilidad y extensiones" as integration_tests
component "interpreter\nInterpreter, StatementExecutor<S>\nStatementExecutionContext<S>" as interpreter
component "lexer\nLexer, TokenScanner" as lexer
component "linter\nLinter, LintRule, CompositeRule\nDiagnosticSource" as linter
component "parser\nParser, StatementParser\nExpressionParser" as parser
component "printscript-ast\nExpression sellada\nStatements oficiales compartidos" as printscript_ast
component "printscript-runtime\nEnvironment, RuntimeValue\nExpressionEvaluator, puertos I/O" as printscript_runtime
component "printscript-v1\nFactories V1 y V1.1\nScanners, gramática, executors\nFormatter, linter, validator" as printscript_v1
component "source-reader\nSourceReader, SourceReaderFactory\nString, Path, InputStream" as source_reader
component "statement-source\nStatement, StatementSource\nParseError" as statement_source
component "token-source\nTokenSource, Token, TokenType\nTokenReadResult" as token_source
component "Clikt" as clikt
component "kotlinx.serialization JSON" as json

cli ..> common : implementation
cli ..> source_reader : implementation
cli ..> token_source : implementation
cli ..> lexer : implementation
cli ..> statement_source : implementation
cli ..> printscript_ast : implementation
cli ..> printscript_runtime : implementation
cli ..> interpreter : implementation
cli ..> formatter : implementation
cli ..> linter : implementation
cli ..> printscript_v1 : implementation
formatter --> token_source : api
integration_tests ..> source_reader : testImplementation
integration_tests ..> interpreter : testImplementation
integration_tests ..> printscript_runtime : testImplementation
integration_tests ..> printscript_v1 : testImplementation
interpreter --> statement_source : api
interpreter --> common : api
lexer --> source_reader : api
lexer --> token_source : api
lexer --> common : api
linter --> statement_source : api
linter --> common : api
parser --> token_source : api
parser --> statement_source : api
printscript_ast --> common : api
printscript_ast --> statement_source : api
printscript_runtime --> interpreter : api
printscript_runtime --> printscript_ast : api
printscript_v1 --> interpreter : api
printscript_v1 --> lexer : api
printscript_v1 --> parser : api
printscript_v1 --> formatter : api
printscript_v1 --> linter : api
printscript_v1 --> token_source : api
printscript_v1 --> statement_source : api
printscript_v1 --> printscript_ast : api
printscript_v1 --> printscript_runtime : api
printscript_v1 --> common : api
statement_source --> common : api
statement_source --> token_source : api
token_source --> common : api
cli ..> clikt : implementation
printscript_v1 ..> json : implementation

legend bottom
  api: dependencia visible en el classpath de compilación del consumidor.
  implementation: dependencia interna, necesaria en runtime.
  testImplementation: solo para pruebas.
  Se omiten stdlib y dependencias comunes de tests y herramientas de buildSrc.
  Los motores se conectan mediante contratos.
  El formatter consume TokenSource; interpreter, linter y validator consumen StatementSource.
endlegend
@enduml
